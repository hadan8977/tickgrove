//@version=5
// Generated by Open Composer Strategy Builder — COINBASE:BTC-USD 1H
strategy("Saved before Tickgrove", overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, default_qty_type=strategy.percent_of_equity, default_qty_value=25)

sma20 = ta.sma(close, 20)

entryCond = close > sma20
exitCond = false

if entryCond and strategy.position_size == 0
    strategy.entry("Entry", strategy.long)
if exitCond
    strategy.close("Entry")
if strategy.position_size != 0
    strategy.exit("Risk", "Entry", stop = strategy.position_avg_price * 0.98, limit = strategy.position_avg_price * 1.06)

plot(sma20, "SMA20")

// @oc-blocks 
