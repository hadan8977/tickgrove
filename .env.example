# Tickgrove preferred names. Every TICKGROVE_* maps to the matching TRADING_* at executable startup.
# Existing TRADING_* remains supported; a supplied TICKGROVE_* value wins.
# This example is not auto-loaded by Rust, CLI, MCP or Paseo; export/source it explicitly.
# Compose keeps legacy trading/trading-data and default project tradingdashboard for data continuity.
TICKGROVE_BIND=127.0.0.1:8471
TICKGROVE_URL=http://127.0.0.1:8471
# TICKGROVE_PORT=8471  # Compose published host port; container still listens on8787.
# Ubuntu user namespace restrictions: load deploy/apparmor/tickgrove, then:
# TICKGROVE_APPARMOR_PROFILE=tickgrove
TICKGROVE_DATA_DIR=./var
# Node is discovered and canonicalized from PATH by default. Optional override:
# TICKGROVE_NODE=/absolute/path/to/node
# Optional explicit >=24-character token; otherwise generated in var/auth-token.
# TICKGROVE_TOKEN=
# Optional array of {"token":"...","permissions":["read","workspace.write","alerts.manage","strategy.write","data.write","backtest.run","paper.manage","broker.paper","plugins.manage"]}.
# Changes/revocation take effect on the next command request.
# TICKGROVE_TOKENS_FILE=./private-tokens.json
# Optional dedicated Alpaca Paper credentials. Live endpoint is never used.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Configurable active market symbol/timeframe subscriptions (1–256; default 32).
# TICKGROVE_MAX_SUBSCRIPTIONS=32
# Optional replacement/extended versioned XNYS calendar JSON.
# TICKGROVE_CALENDAR_FILE=/path/to/xnys-calendar.json
# Bounded, disposable historical response cache (64 MiB default, 1 MiB–1 GiB).
# Strategy snapshots and execution journals are separate and are never evicted by this cache.
# TICKGROVE_HISTORY_CACHE_BYTES=67108864
# Optional Alpaca credentials can also be saved in Settings > Connections.
# UI-managed credentials are stored privately under the instance data directory.
# Include connections.manage when issuing a token that can edit/test account connections.
